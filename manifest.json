{
  "manifest_version": 3,
  "name": "Roody Companion \u2014 Hackathon Demo",
  "version": "3.2.0",
  "minimum_chrome_version": "116",
  "description": "A speaking companion inside one orb: learn, code and plan with optional page context, screen sharing and demo access.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://midnightblue-wolf-859857.hostingersite.com/*",
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/orb-voice.html",
        "src/orb-voice.js",
        "src/orb-voice.css",
        "src/options.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Summon / hide Roody on this page"
    }
  },
  "action": {
    "default_title": "Summon Roody on this page",
    "default_icon": {
      "16": "icons/roody16.png",
      "48": "icons/roody48.png",
      "128": "icons/roody128.png"
    }
  },
  "icons": {
    "16": "icons/roody16.png",
    "48": "icons/roody48.png",
    "128": "icons/roody128.png"
  }
}
