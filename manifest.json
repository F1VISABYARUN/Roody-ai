{
  "manifest_version": 3,
  "name": "Roody Companion — Hackathon Demo",
  "version": "3.1.0",
  "description": "Your companion for learning, coding and planning: a floating orb, personas, goals, screen analysis and an OpenAI live voice window.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*",
    "https://midnightblue-wolf-859857.hostingersite.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Summon / hide Roody on this page"
    }
  },
  "action": {
    "default_title": "Summon Roody on this page",
    "default_icon": {
      "16": "icons/roody16.png",
      "48": "icons/roody48.png",
      "128": "icons/roody128.png"
    }
  },
  "icons": {
    "16": "icons/roody16.png",
    "48": "icons/roody48.png",
    "128": "icons/roody128.png"
  }
}
