{
  "manifest_version": 3,
  "name": "Roody — your AI voice companion",
  "version": "1.2.0",
  "description": "Summon an AI friend on any page. It reads along, studies PDFs with you, and talks by voice. Loads only when clicked.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "file:///*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.elevenlabs.io/*",
    "https://api.x.ai/*",
    "https://midnightblue-wolf-859857.hostingersite.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Summon / hide Roody on this page"
    }
  },
  "action": {
    "default_title": "Summon Roody on this page",
    "default_icon": {
      "16": "icons/roody16.png",
      "48": "icons/roody48.png",
      "128": "icons/roody128.png"
    }
  },
  "icons": {
    "16": "icons/roody16.png",
    "48": "icons/roody48.png",
    "128": "icons/roody128.png"
  }
}